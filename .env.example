# Groq API key - get a free one at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Model used for profile extraction, path curation and the assistant.
# Any Groq text model works; see https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: point the SQLite file at a writable volume.
# Streamlit Community Cloud has an ephemeral filesystem, so data written to the
# default path is lost on reboot or redeploy.
# PATHFINDER_DB=/mount/data/pathfinder.db

# Optional shared access code for the Streamlit app. Unset = open access.
# APP_ACCESS_CODE=pick-something-long

# Set to 1 to list existing learners on the start screen. Off by default so a
# public deployment does not expose every learner's name and goal.
# PATHFINDER_SHOW_LEARNERS=1
