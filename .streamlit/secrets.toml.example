# Streamlit Cloud: paste this under App settings -> Secrets.
# Locally: copy to .streamlit/secrets.toml (git-ignored) or just use .env

GROQ_API_KEY = "gsk_your_key_here"
GROQ_MODEL = "openai/gpt-oss-120b"

# Optional. When set, the whole app is gated behind this shared code.
# This is an access gate, not per-user login: anyone with the code sees
# everything. Leave unset for local development.
# APP_ACCESS_CODE = "pick-something-long"
